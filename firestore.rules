service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Admin Rule: Allow specific emails to read/write EVERYTHING
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email in ["hyewonh@gmail.com"];
    }

    match /users/{userId} {
      // Allow user to read/write their own profile data
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow user to read/write their own subcollections (like series_progress)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /verses/{verseId} {
      allow read: if true;
      allow write: if false; // Admin only (covered by global rule)
    }
    
    match /user_progress/{progressId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /referrals/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /admin_promo_codes/{code} {
      // Anyone logged in can read a code (to check validity)
      allow read: if request.auth != null;
      // Users can update (mark as used) but only via client — admin can write freely
      allow write: if request.auth != null && 
        (request.auth.token.email in ["hyewonh@gmail.com"] ||
         // Allow users to mark a code as used (usedBy must be their own uid)
         (request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid));
    }

    // Shared series: anyone can read, owner can write/delete
    match /shared_series/{shareId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Comments: anyone can read, logged-in users can create
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.authorUid == request.auth.uid;
      }
    }

    // Leaderboard: anyone authenticated can read, only self can write
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
